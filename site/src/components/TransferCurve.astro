---
/**
 * How much of the source accuracy survives the transfer, against genetic
 * distance, at three levels of surviving LD tagging.
 *
 * THIS FIGURE CARRIES NO SIMULATED POINTS. It is steps 2 and 3 of the chain
 * drawn out, and no run in this repository measures the pair (F_ST, surviving
 * accuracy) directly, so nothing is plotted that was not computed from the two
 * formulas.
 *
 *   V_target = rho^2 (1 - F_ST) V_A
 *   R^2      = V_target / ((1 - F_ST) V_A + V_E)
 *
 * V_A = 0.2 and V_E = 0.8 are the worked example of the interactive panel, so
 * the source score explains a fifth of the liability before transfer.
 */
const V_A = 0.2, V_E = 0.8;
const r2Target = (fst: number, rho2: number) =>
  (rho2 * (1 - fst) * V_A) / ((1 - fst) * V_A + V_E);
const r2Source = V_A / (V_A + V_E);
const kept = (fst: number, rho2: number) => r2Target(fst, rho2) / r2Source;

/** surviving LD tagging, dash pattern, label */
const series = [
  { rho2: 1.0, dash: "", label: "all LD tagging kept" },
  { rho2: 0.8, dash: "7 5", label: "80% kept" },
  { rho2: 0.5, dash: "2 4", label: "50% kept" },
];

const W = 760, H = 330, L = 62, R = 150, T = 18, B = 48;
const iw = W - L - R, ih = H - T - B;
const XMAX = 0.3;
const X = (v: number) => L + (v / XMAX) * iw;
const Y = (v: number) => H - B - (v / 1.05) * ih;

const paths = series.map((s) => {
  let d = "";
  for (let i = 0; i <= 240; i++) {
    const fst = (XMAX * i) / 240;
    d += (i ? "L" : "M") + X(fst).toFixed(2) + " " + Y(kept(fst, s.rho2)).toFixed(2);
  }
  return { ...s, d, endY: Y(kept(XMAX, s.rho2)) };
});

// Two populations that split 400 generations ago at effective size 10,000.
const EXAMPLE = 400 / (400 + 2 * 10000);
---

<figure class="fig">
  <figcaption class="fig-title">
    Lost LD tagging costs more liability R² than F<sub>ST</sub> does
  </figcaption>
  <svg viewBox={`0 0 ${W} ${H}`} role="img"
       aria-label="Share of the source liability R-squared that survives in the target population, against Hudson F-ST, drawn for three levels of surviving LD tagging. The curves are the closed form and carry no simulated points.">
    {[0, 0.25, 0.5, 0.75, 1].map((v) => (
      <>
        <line x1={L} x2={W - R} y1={Y(v)} y2={Y(v)} class="grid" />
        <text x={L - 10} y={Y(v) + 4} class="tick" text-anchor="end">{(v * 100).toFixed(0)}%</text>
      </>
    ))}
    {[0, 0.05, 0.1, 0.15, 0.2, 0.25, 0.3].map((v) => (
      <text x={X(v)} y={H - B + 20} class="tick" text-anchor="middle">{v.toFixed(2)}</text>
    ))}
    <text x={L + iw / 2} y={H - 10} class="axis" text-anchor="middle">
      Hudson F<tspan baseline-shift="sub" font-size="0.78em">ST</tspan> between the two populations
    </text>
    <text x={16} y={T + ih / 2} class="axis" text-anchor="middle"
          transform={`rotate(-90 16 ${T + ih / 2})`}>share of the source liability R² kept</text>

    <line x1={X(EXAMPLE)} x2={X(EXAMPLE)} y1={T} y2={H - B} class="marker" />
    <text x={X(EXAMPLE) + 7} y={T + 12} class="tick">
      400 generations at effective size 10,000
    </text>

    {paths.map((p) => (
      <>
        <path d={p.d} class="curve" stroke-dasharray={p.dash || undefined} />
        <text x={W - R + 8} y={p.endY + 4} class="tick">{p.label}</text>
      </>
    ))}
  </svg>
  <p class="fig-note">
    Hudson F-ST shrinks the additive variance the score explains and the target
    population's whole liability variance together, so it costs less than its
    size suggests: an F-ST of 0.2, larger than any pair of continental human
    populations reaches, still leaves 83% of the source liability R² standing.
    Lost LD tagging multiplies the target liability R² directly, so halving the
    tagging halves the R². The two enter as a product and neither predicts the
    other. Every curve comes from the formulas in steps 2 and 3. No simulation
    stands behind this figure.
  </p>
</figure>
